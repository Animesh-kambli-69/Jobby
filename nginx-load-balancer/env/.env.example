# ==============================================================================
# Jobby Nginx Hybrid Load Balancer Configuration
# Hosted on Render Web Service -> Load balances EC2 Backend + Render Backend
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AWS EC2 Backend Configuration
# ------------------------------------------------------------------------------
# EC2 public IP or DNS hostname (e.g., 54.123.45.67 or ec2-xx.compute-1.amazonaws.com)
EC2_BACKEND_HOST=54.123.45.67

# Port where Node.js / Express is listening on EC2 (default: 5000)
EC2_BACKEND_PORT=5000

# Protocol for EC2 backend: http (default) or https
EC2_BACKEND_PROTOCOL=http

# ------------------------------------------------------------------------------
# 2. Render Backend Configuration
# ------------------------------------------------------------------------------
# Render backend service hostname:
# - If Public Web Service: your-backend.onrender.com (uses HTTPS on port 443)
# - If Private Service: your-service-slug (uses HTTP on port 5000)
RENDER_BACKEND_HOST=your-backend.onrender.com

# Port for Render backend:
# Automatically defaults to 443 if using https / onrender.com, or 5000 for private services
RENDER_BACKEND_PORT=443

# Protocol: https (default for .onrender.com) or http (for private services)
RENDER_BACKEND_PROTOCOL=https

# ------------------------------------------------------------------------------
# 3. Load Balancer Port (Render Platform)
# ------------------------------------------------------------------------------
# Render sets PORT automatically (e.g., 10000). For local Docker testing, default is 8080.
PORT=8080
